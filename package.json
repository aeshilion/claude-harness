{
  "name": "claude-harness",
  "displayName": "Claude Harness",
  "description": "Visualize and edit your Claude Code harness in VS Code: memory, rules, agents, skills, commands, output styles, workflows, hooks, MCP servers and plugins, globally and per repository.",
  "version": "0.1.26",
  "publisher": "integrations-at",
  "license": "CC-BY-NC-SA-4.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F1E1D",
    "theme": "dark"
  },
  "author": {
    "name": "Alexander Kastil",
    "email": "alexander.kastil@integrations.at",
    "url": "https://integrations.at/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexander-kastil/claude-harness"
  },
  "homepage": "https://github.com/alexander-kastil/claude-harness#readme",
  "bugs": {
    "url": "https://github.com/alexander-kastil/claude-harness/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "harness",
    "agents",
    "skills",
    "anthropic",
    "mcp",
    "hooks",
    "CLAUDE.md"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Claude Harness",
      "properties": {
        "claudeHarness.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder of the global harness. Empty means `~/.claude`.",
          "order": 1
        },
        "claudeHarness.repoFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders added with **Add Repo...**. Each is a repo folder, or a parent folder whose subfolders are repos. A folder is listed when it has a `.claude` folder or a `CLAUDE.md`.",
          "order": 2
        },
        "claudeHarness.removedRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Repo folders hidden with **Remove Repo...**. Adding the repo or its parent folder again shows it again.",
          "order": 3
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeHarness",
          "title": "Claude Harness",
          "icon": "media/harness.svg"
        }
      ]
    },
    "views": {
      "claudeHarness": [
        {
          "id": "claudeHarness.tree",
          "name": "Claude Harness",
          "icon": "media/harness.svg",
          "contextualTitle": "Claude Harness"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeHarness.open",
        "title": "Open Claude Harness",
        "category": "Claude Harness",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "claudeHarness.addRepo",
        "title": "Add Repo...",
        "category": "Claude Harness",
        "icon": "$(repo-create)"
      },
      {
        "command": "claudeHarness.removeRepo",
        "title": "Remove Repo...",
        "category": "Claude Harness",
        "icon": "$(trash)"
      },
      {
        "command": "claudeHarness.refresh",
        "title": "Refresh",
        "category": "Claude Harness",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeHarness.create",
        "title": "New...",
        "category": "Claude Harness",
        "icon": "$(add)"
      },
      {
        "command": "claudeHarness.configureTools",
        "title": "Configure Tools...",
        "category": "Claude Harness"
      },
      {
        "command": "claudeHarness.openFile",
        "title": "Open File",
        "category": "Claude Harness",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeHarness.rename",
        "title": "Rename...",
        "category": "Claude Harness",
        "icon": "$(edit)"
      },
      {
        "command": "claudeHarness.duplicate",
        "title": "Duplicate...",
        "category": "Claude Harness",
        "icon": "$(copy)"
      },
      {
        "command": "claudeHarness.delete",
        "title": "Delete",
        "category": "Claude Harness",
        "icon": "$(trash)"
      },
      {
        "command": "claudeHarness.reveal",
        "title": "Reveal in File Explorer",
        "category": "Claude Harness",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeHarness.togglePlugin",
        "title": "Enable / Disable Plugin",
        "category": "Claude Harness",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "claudeHarness.addMcp",
        "title": "Add MCP Server...",
        "category": "Claude Harness",
        "icon": "$(add)"
      },
      {
        "command": "claudeHarness.copyMcpAdd",
        "title": "Copy as claude mcp add Command",
        "category": "Claude Harness",
        "icon": "$(copy)"
      },
      {
        "command": "claudeHarness.openClaude",
        "title": "Open Claude Here",
        "category": "Claude Harness",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeHarness.installPlugin",
        "title": "Install Plugin...",
        "category": "Claude Harness",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeHarness.uninstallPlugin",
        "title": "Uninstall Plugin...",
        "category": "Claude Harness",
        "icon": "$(trash)"
      },
      {
        "command": "claudeHarness.openSettings",
        "title": "Open Settings File...",
        "category": "Claude Harness",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeHarness.open",
          "when": "view == claudeHarness.tree",
          "group": "navigation@1"
        },
        {
          "command": "claudeHarness.create",
          "when": "view == claudeHarness.tree",
          "group": "navigation@2"
        },
        {
          "command": "claudeHarness.refresh",
          "when": "view == claudeHarness.tree",
          "group": "navigation@3"
        },
        {
          "command": "claudeHarness.openClaude",
          "when": "view == claudeHarness.tree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeHarness.create",
          "when": "view == claudeHarness.tree && viewItem == category.creatable",
          "group": "inline@1"
        },
        {
          "command": "claudeHarness.togglePlugin",
          "when": "view == claudeHarness.tree && viewItem == asset.plugin",
          "group": "inline@1"
        },
        {
          "command": "claudeHarness.openFile",
          "when": "view == claudeHarness.tree && viewItem =~ /^(asset|file)/",
          "group": "inline@2"
        },
        {
          "command": "claudeHarness.openFile",
          "when": "view == claudeHarness.tree && viewItem =~ /^(asset|file)/",
          "group": "1_open@1"
        },
        {
          "command": "claudeHarness.reveal",
          "when": "view == claudeHarness.tree && viewItem =~ /^(asset|file)/",
          "group": "1_open@2"
        },
        {
          "command": "claudeHarness.rename",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.](agent|skill|command|outputStyle|rule|workflow)$/",
          "group": "2_edit@1"
        },
        {
          "command": "claudeHarness.duplicate",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.](agent|skill|command|outputStyle|rule|workflow)$/",
          "group": "2_edit@2"
        },
        {
          "command": "claudeHarness.delete",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.](agent|skill|command|outputStyle|rule|workflow)$/",
          "group": "3_delete@1"
        },
        {
          "command": "claudeHarness.uninstallPlugin",
          "when": "view == claudeHarness.tree && viewItem == asset.plugin",
          "group": "3_delete@1"
        },
        {
          "command": "claudeHarness.delete",
          "when": "view == claudeHarness.tree && viewItem == asset.mcp.stored",
          "group": "3_delete@1"
        },
        {
          "command": "claudeHarness.copyMcpAdd",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.]mcp/",
          "group": "2_edit@1"
        },
        {
          "command": "claudeHarness.openSettings",
          "when": "view == claudeHarness.tree && viewItem == category.settings",
          "group": "inline@1"
        },
        {
          "command": "claudeHarness.installPlugin",
          "when": "view == claudeHarness.tree && viewItem == category.plugin",
          "group": "inline@1"
        },
        {
          "command": "claudeHarness.addMcp",
          "when": "view == claudeHarness.tree && viewItem == category.mcp",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeHarness.configureTools",
          "when": "false"
        },
        {
          "command": "claudeHarness.openFile",
          "when": "false"
        },
        {
          "command": "claudeHarness.rename",
          "when": "false"
        },
        {
          "command": "claudeHarness.duplicate",
          "when": "false"
        },
        {
          "command": "claudeHarness.delete",
          "when": "false"
        },
        {
          "command": "claudeHarness.reveal",
          "when": "false"
        },
        {
          "command": "claudeHarness.togglePlugin",
          "when": "false"
        },
        {
          "command": "claudeHarness.copyMcpAdd",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeHarness.tree",
        "contents": "No Claude harness found yet.\n[Open Claude Harness](command:claudeHarness.open)\n[Add Repo...](command:claudeHarness.addRepo)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
