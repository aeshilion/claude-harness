{
  "name": "claude-harness",
  "displayName": "Claude Harness",
  "description": "Visualize and edit the global Claude Code harness in ~/.claude: memory, rules, agents, skills, commands, output styles, workflows, hooks, MCP servers and plugins.",
  "version": "0.1.4",
  "publisher": "integrations-at",
  "license": "MIT",
  "author": {
    "name": "Alexander Kastil",
    "email": "alexander.kastil@integrations.at"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexander-kastil/claude-harness"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "harness",
    "agents",
    "skills"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Claude Harness",
      "properties": {
        "claudeHarness.root": {
          "type": "string",
          "default": "",
          "description": "Folder of the global harness. Empty means ~/.claude."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeHarness",
          "title": "Claude Harness",
          "icon": "media/harness.svg"
        }
      ]
    },
    "views": {
      "claudeHarness": [
        {
          "id": "claudeHarness.tree",
          "name": "Global Harness"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeHarness.open",
        "title": "Open Global Harness",
        "category": "Claude Harness",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "claudeHarness.refresh",
        "title": "Refresh",
        "category": "Claude Harness",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeHarness.create",
        "title": "New...",
        "category": "Claude Harness",
        "icon": "$(add)"
      },
      {
        "command": "claudeHarness.openFile",
        "title": "Open File",
        "category": "Claude Harness",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeHarness.rename",
        "title": "Rename...",
        "category": "Claude Harness",
        "icon": "$(edit)"
      },
      {
        "command": "claudeHarness.duplicate",
        "title": "Duplicate...",
        "category": "Claude Harness",
        "icon": "$(copy)"
      },
      {
        "command": "claudeHarness.delete",
        "title": "Delete",
        "category": "Claude Harness",
        "icon": "$(trash)"
      },
      {
        "command": "claudeHarness.reveal",
        "title": "Reveal in File Explorer",
        "category": "Claude Harness",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeHarness.togglePlugin",
        "title": "Enable / Disable Plugin",
        "category": "Claude Harness",
        "icon": "$(circle-large-outline)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeHarness.open",
          "when": "view == claudeHarness.tree",
          "group": "navigation@1"
        },
        {
          "command": "claudeHarness.create",
          "when": "view == claudeHarness.tree",
          "group": "navigation@2"
        },
        {
          "command": "claudeHarness.refresh",
          "when": "view == claudeHarness.tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeHarness.create",
          "when": "view == claudeHarness.tree && viewItem == category.creatable",
          "group": "inline@1"
        },
        {
          "command": "claudeHarness.togglePlugin",
          "when": "view == claudeHarness.tree && viewItem == asset.plugin",
          "group": "inline@1"
        },
        {
          "command": "claudeHarness.openFile",
          "when": "view == claudeHarness.tree && viewItem =~ /^(asset|file)/",
          "group": "inline@2"
        },
        {
          "command": "claudeHarness.openFile",
          "when": "view == claudeHarness.tree && viewItem =~ /^(asset|file)/",
          "group": "1_open@1"
        },
        {
          "command": "claudeHarness.reveal",
          "when": "view == claudeHarness.tree && viewItem =~ /^(asset|file)/",
          "group": "1_open@2"
        },
        {
          "command": "claudeHarness.rename",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.](agent|skill|command|outputStyle|rule|workflow)$/",
          "group": "2_edit@1"
        },
        {
          "command": "claudeHarness.duplicate",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.](agent|skill|command|outputStyle|rule|workflow)$/",
          "group": "2_edit@2"
        },
        {
          "command": "claudeHarness.delete",
          "when": "view == claudeHarness.tree && viewItem =~ /^asset[.](agent|skill|command|outputStyle|rule|workflow)$/",
          "group": "3_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeHarness.openFile",
          "when": "false"
        },
        {
          "command": "claudeHarness.rename",
          "when": "false"
        },
        {
          "command": "claudeHarness.duplicate",
          "when": "false"
        },
        {
          "command": "claudeHarness.delete",
          "when": "false"
        },
        {
          "command": "claudeHarness.reveal",
          "when": "false"
        },
        {
          "command": "claudeHarness.togglePlugin",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/unit/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
